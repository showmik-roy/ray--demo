//Palindrome Number
//leetcode

#include <iostream>
using namespace std;

int main() {

    int x;
    cin >> x;

    if (x < 0) {
        cout << "false" << endl;
        return 0;
    }

    long reverse = 0;
    int xcopy = x;

    while (x > 0) {
        reverse = (reverse * 10) + (x % 10);
        x /= 10;
    }

    if (reverse == xcopy)
        cout << "true" << endl;
    else
        cout << "false" << endl;

    return 0;
}
